   87   219                      ; _@DIVR        a result of div library
   88   220                      ; _@LDIVR       a result of ldiv library
   89   221                      ; _@TOKPTR      pointer which strtok function uses
   90   222                      ; _errno        errno number code
   91   223                      ; _@MEMTOP      top address of area which memory management functions use
