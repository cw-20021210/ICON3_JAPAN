   57   189                      ; external declaration of symbol for stack area
   58   190                      ;
   59   191                      ; _@STBEG has value of the end address +1 of compiler's stack area.
   60   192                      ; _@STBEG is created by linker with -S option.
   61   193                      ; Accordingly, specify the -S option when linking.
   62   194                      ;
   63   195                      ; _@MAA has value of the mirror area.
